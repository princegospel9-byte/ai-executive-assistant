    },
    "Supersede Old Approval": {
      "main": [[{ "node": "Fetch Email With Analysis", "type": "main", "index": 0 }]]
    },
    "Fetch Email With Analysis": {
      "main": [[{ "node": "Build AI Request", "type": "main", "index": 0 }]]
    },
    "Build AI Request": {
      "main": [[{ "node": "Call AI - Process Request", "type": "main", "index": 0 }]]
    },
    "Call AI - Process Request": {
      "main": [[{ "node": "Prepare Draft Insert", "type": "main", "index": 0 }]]
    },
    "Prepare Draft Insert": {
      "main": [[{ "node": "Insert Draft Reply", "type": "main", "index": 0 }]]
    },
    "Insert Draft Reply": {
