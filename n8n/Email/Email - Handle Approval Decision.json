{
  "name": "Email - Handle Approval Decision",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "email-approval-decision",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "549924a1-8fee-4f8a-9150-5805fbf39010",
      "name": "Called From Dashboard (Approve/Reject)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1800,
        0
      ],
      "notes": "Requires header x-automation-secret matching N8N_WEBHOOK_SECRET. Body: { approval_id, decision: 'approved' | 'rejected' }. This is the ONLY workflow allowed to actually send a Gmail message - and only on decision='approved'.",
      "webhookId": "46d14a5d-4af7-41d1-bffb-ca0d24fdd71d"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.body || {};\nconst providedSecret = item.headers?.['x-automation-secret'] || item.headers?.['X-Automation-Secret'];\nconst authOk = providedSecret === $env.N8N_WEBHOOK_SECRET;\n\nreturn [{\n  json: {\n    approval_id: payload.approval_id,\n    decision: payload.decision,\n    auth_ok: authOk\n  }\n}];"
      },
      "id": "15fb35e6-7fa5-4223-b1c6-3ee755ee0888",
      "name": "Normalize & Check Auth",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
