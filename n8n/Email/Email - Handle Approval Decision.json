            }
          ]
        },
        "options": {}
      },
      "id": "db806054-77c0-47af-b133-a14d0edb37c9",
      "name": "Fetch Draft With Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1200,
        -150
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $('Normalize & Check Auth').first().json.decision }}",
              "rightValue": "approved",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d8eee1b9-fed6-4dfb-aac0-344c685ed4bf",
      "name": "Is Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -1000,
        -150
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json;\nconst draft = Array.isArray(rows) ? rows[0] : rows;\nif (!draft) {\n  throw new Error('Draft not found for approval_id: ' + $('Normalize & Check Auth').first().json.approval_id);\n}\nconst emailRaw = draft.emails;\nconst email = Array.isArray(emailRaw) ? emailRaw[0] : emailRaw;\nconst bodyText = draft.edited_text || draft.draft_text;\nconst subject = (email.subject || '').toLowerCase().startsWith('re:') ? email.subject : `Re: ${email.subject || ''}`;\n\nconst headerLines = [\n  `To: ${email.from_address}`,\n  `Subject: ${subject}`,\n];\nif (email.rfc_message_id) {\n  headerLines.push(`In-Reply-To: ${email.rfc_message_id}`);\n  headerLines.push(`References: ${email.rfc_message_id}`);\n}\nheaderLines.push('Content-Type: text/plain; charset=utf-8');\n\nconst rawMessage = headerLines.join('\\r\\n') + '\\r\\n\\r\\n' + bodyText;\nconst base64url = Buffer.from(rawMessage).toString('base64')\n  .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\n\nreturn [{\n  json: {\n    raw: base64url,\n    threadId: email.gmail_thread_id,\n    draft_id: draft.id,\n    approval_id: draft.approval_id,\n    email_id: email.id,\n    user_id: draft.user_id,\n    from_address: email.from_address\n  }\n}];"
      },
      "id": "8075313a-04ea-4afa-9cda-8cc6ef2f1d6b",
      "name": "Build Raw Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -800,
        -300
      ],
      "notes": "Threads correctly via In-Reply-To/References headers (from the original email's RFC Message-ID, captured at ingestion) plus Gmail's own threadId."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages/send",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ raw: $json.raw, threadId: $json.threadId }) }}",
        "options": {}
      },
      "id": "6f49dbad-de69-4ce2-9a65-3a92a4b5447e",
      "name": "Send Gmail Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -600,
        -300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail account"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "notes": "Deliberately only 2 retries (not 3) here - a retried send after a genuine partial failure risks a duplicate email reaching the recipient, which is worse than surfacing the error via Core - Error Handler.",
      "alwaysOutputData": true
    },
    {
