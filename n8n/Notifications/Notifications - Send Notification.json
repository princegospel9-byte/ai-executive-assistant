{
  "name": "Notifications - Send Notification",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "5f1147eb-060d-4d0d-8139-b0762bcd1e2b",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -400,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/notifications",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ user_id: $json.user_id, title: $json.title, message: $json.message || null, severity: $json.severity || 'info', channel: $json.channel || 'in_app', related_record_type: $json.related_record_type || null, related_record_id: $json.related_record_id || null }) }}",
        "options": {}
      },
      "id": "d9574eec-8bd9-4f8c-b7c2-7a8d1905a8e5",
      "name": "Insert Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -200,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "channel is stored either way, but only 'in_app' actually delivers anywhere today (the dashboard's Notifications view). 'email'/'whatsapp' delivery activates once those integrations exist in later phases.",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const row = $('Insert Notification').first().json;\nconst notification = Array.isArray(row) ? row[0] : row;\nreturn [{ json: { success: true, notification_id: notification.id } }];"
      },
      "id": "84b3c415-8540-4d31-bc2a-2b7f2a9addb6",
      "name": "Return Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $('Insert Notification').first().json.severity }}",
              "rightValue": "warning",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "leftValue": "={{ $('Insert Notification').first().json.severity }}",
              "rightValue": "critical",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "notif01",
      "name": "Needs External Delivery?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -200,
        150
      ],
      "notes": "Only warning/critical severity goes external (email/Telegram) - info-level notifications (e.g. \"Event created\") stay in-app only, matching what actually needs attention."
    },
    {
      "parameters": {
        "jsCode": "const n = $('Insert Notification').first().json;\nconst lines = [\n  'To: kbrisksenterprise@gmail.com',\n  `Subject: [KBrisks AI] ${n.title}`,\n  'Content-Type: text/plain; charset=utf-8',\n  '',\n  n.message || n.title\n];\nconst raw = Buffer.from(lines.join('\\r\\n')).toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\nreturn [{ json: { raw } }];"
      },
      "id": "notif02",
      "name": "Build Notification Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages/send",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ raw: $json.raw }) }}",
        "options": {}
      },
      "id": "notif03",
      "name": "Send Email Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        100
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail account"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: `*${$('Insert Notification').first().json.title}*\\n${$('Insert Notification').first().json.message || ''}`, parse_mode: 'Markdown' }) }}",
        "options": {}
      },
      "id": "notif04",
      "name": "Send Telegram Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        200
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "notes": "Requires TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID env vars to be set - see @BotFather setup."
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-notification",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "notifwh01",
      "name": "Called Externally (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -400,
        350
      ],
      "notes": "Second entry point into this SAME workflow - 'When Called' (Execute Workflow Trigger) is unchanged and still used by every existing internal caller. Requires header x-automation-secret (same N8N_WEBHOOK_SECRET convention as every other webhook in this repo - see Calendar - Create Event.json). Body: { user_id, title, message?, severity?, channel?, related_record_type?, related_record_id? } - the same logical payload 'When Called' already accepts. Converges into the existing Insert Notification -> Needs External Delivery? -> email/Telegram path below, unchanged - this trigger duplicates no delivery logic.",
      "webhookId": "b6e6b5b0-9b1a-4b7e-9c8b-8a6a2c9a5b7f"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.body || {};\nconst providedSecret = item.headers?.['x-automation-secret'] || item.headers?.['X-Automation-Secret'];\nconst authOk = providedSecret === $env.N8N_WEBHOOK_SECRET;\nreturn [{\n  json: {\n    user_id: payload.user_id,\n    title: payload.title,\n    message: payload.message || null,\n    severity: payload.severity || 'info',\n    channel: payload.channel || 'in_app',\n    related_record_type: payload.related_record_type || null,\n    related_record_id: payload.related_record_id || null,\n    auth_ok: authOk\n  }\n}];"
      },
      "id": "notifwh02",
      "name": "Normalize & Check Auth (Webhook)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        350
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.auth_ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "notifwh03",
      "name": "Authorized? (Webhook)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        0,
        350
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, error: 'Unauthorized' } }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "notifwh04",
      "name": "Respond 401 (Webhook)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        200,
        500
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $execution.mode }}",
              "rightValue": "webhook",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "notifwh05",
      "name": "Triggered Via Webhook?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        200,
        350
      ],
      "notes": "Branches on $execution.mode ('webhook' vs 'integrated' for an Execute Workflow call) rather than which node fired - reliable regardless of how many upstream trigger paths exist. Fed directly from Insert Notification, BEFORE Needs External Delivery?/Return Result, so responding to the webhook never has to wait for (or run more than once because of) the email/Telegram fan-out below, which already runs Return Result more than once for warning/critical severity - unrelated to and unaffected by this branch."
    },
    {
      "parameters": {
        "jsCode": "const row = $('Insert Notification').first().json;\nconst notification = Array.isArray(row) ? row[0] : row;\nreturn [{ json: { success: true, notification_id: notification.id } }];"
      },
      "id": "notifwh06",
      "name": "Build Webhook Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ],
      "notes": "Same shape as the existing 'Return Result' node, kept as a separate node deliberately - 'Return Result' already has three converging inputs (once per email/Telegram/no-delivery path) and firing an HTTP webhook response from a node that can execute more than once per run would error on the second attempt. This node only ever runs once (directly off Insert Notification, gated by Triggered Via Webhook? above)."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "notifwh07",
      "name": "Respond 200 (Webhook)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        600,
        300
      ]
    }
  ],
  "connections": {
    "When Called": {
      "main": [
        [
          {
            "node": "Insert Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insert Notification": {
      "main": [
        [
          {
            "node": "Needs External Delivery?",
            "type": "main",
            "index": 0
          },
          {
            "node": "Triggered Via Webhook?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Called Externally (Webhook)": {
      "main": [
        [
          {
            "node": "Normalize & Check Auth (Webhook)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize & Check Auth (Webhook)": {
      "main": [
        [
          {
            "node": "Authorized? (Webhook)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Authorized? (Webhook)": {
      "main": [
        [
          {
            "node": "Insert Notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 401 (Webhook)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Triggered Via Webhook?": {
      "main": [
        [
          {
            "node": "Build Webhook Response",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Build Webhook Response": {
      "main": [
        [
          {
            "node": "Respond 200 (Webhook)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs External Delivery?": {
      "main": [
        [
          {
            "node": "Build Notification Email",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Telegram Notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Notification Email": {
      "main": [
        [
          {
            "node": "Send Email Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email Notification": {
      "main": [
        [
          {
            "node": "Return Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Telegram Notification": {
      "main": [
        [
          {
            "node": "Return Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "MwGiYLuimBUn0yYD"
  },
  "pinData": {}
}
