        "responseMode": "responseNode",
        "options": {}
      },
      "id": "efc7e7fc-9a17-41c1-811a-ab1dcf95247f",
      "name": "Called From Dashboard (Generate Message)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1800,
        0
      ],
      "notes": "Requires header x-automation-secret. Body: { school_id, message_type, channel }",
      "webhookId": "2c94dafb-633c-43e3-907b-dcf51eb33c39"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.body || {};\nconst providedSecret = item.headers?.['x-automation-secret'] || item.headers?.['X-Automation-Secret'];\nconst authOk = providedSecret === $env.N8N_WEBHOOK_SECRET;\nreturn [{ json: { school_id: payload.school_id, message_type: payload.message_type, channel: payload.channel, auth_ok: authOk } }];"
      },
      "id": "47e62cc2-49c1-4c01-b131-6c9f443775de",
