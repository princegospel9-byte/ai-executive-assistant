    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/generated_messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "=eq.{{ $('Build Approval Request').first().json.generated_message_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ approval_id: $json.approval_id }) }}",
        "options": {}
      },
      "id": "2c7fa938-dae2-44ae-a8c6-fb323e29e66a",
      "name": "Link Approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        -300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const rows = $('Insert Message').first().json;\nconst message = Array.isArray(rows) ? rows[0] : rows;\nlet approvalId = null;\ntry {\n  approvalId = $('Build Approval Request').first().json.approval_id ?? null;\n} catch (e) {\n  // Not reached on the whatsapp (no-approval) branch - approvalId stays null, which is correct.\n}\nreturn [{ json: { success: true, message_id: message.id, channel: message.channel, subject: message.subject, content: message.content, approval_id: approvalId } }];"
      },
      "id": "9497572a-b214-4a4f-a46b-f431fbe3b198",
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "notes": "References 'Insert Message' by name explicitly rather than relying on the immediately-preceding node's shape, since it's reachable from two different branches (email vs whatsapp)."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "c3fd5152-ba70-46b4-a332-3fba87be8491",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
