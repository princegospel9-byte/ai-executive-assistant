      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -1400,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, error: 'Unauthorized' } }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "040ffb7f-dbd2-4d04-96c0-5ceb7855a1b3",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -1200,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/schools",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "=eq.{{ $('Normalize & Check Auth').first().json.school_id }}"
            },
            {
              "name": "select",
              "value": "*,school_interactions(interaction_type,notes,occurred_at)"
            }
          ]
        },
        "options": {}
      },
      "id": "3ebf753a-e322-4d07-ba31-2b7ba9cf6016",
      "name": "Fetch School With Interactions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1200,
        -150
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json;\nconst school = Array.isArray(rows) ? rows[0] : rows;\nif (!school) {\n  throw new Error('School not found for id: ' + $('Normalize & Check Auth').first().json.school_id);\n}\nconst interactions = school.school_interactions || [];\nconst historyText = interactions.length\n  ? interactions.slice(0, 5).map(i => `- ${new Date(i.occurred_at).toLocaleDateString()} (${i.interaction_type}): ${i.notes || ''}`).join('\\n')\n  : 'No recorded interactions yet.';\n\nconst auth = $('Normalize & Check Auth').first().json;\n\nreturn [{\n  json: {\n    prompt_key: 'crm_message',\n    user_id: school.user_id,\n    feature: 'crm_message',\n    related_record_type: 'school',\n    related_record_id: school.id,\n    variables: {\n      school_name: school.school_name,\n      contact_person: school.contact_person || 'the school administrator',\n      message_type: auth.message_type,\n      channel: auth.channel,\n      context: historyText\n    }\n  }\n}];"
      },
      "id": "c14e0398-a51a-4a8a-b86b-d865c4f0bf89",
      "name": "Build AI Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1000,
        -150
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "NScqkbAehRkYoqbX",
          "mode": "list",
          "cachedResultName": "AI - Process Request"
        },
        "options": {}
      },
      "id": "043e6e80-c1fb-4758-805b-66d5f8dac0a7",
      "name": "Call AI - Process Request",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        -800,
        -150
      ]
    },
    {
      "parameters": {
        "jsCode": "const aiResult = $input.first().json;\nconst output = aiResult.output;\nconst built = $('Build AI Request').first().json;\nreturn [{\n  json: {\n    user_id: built.user_id,\n    school_id: built.related_record_id,\n    message_type: built.variables.message_type,\n    channel: built.variables.channel,\n    subject: output.subject || null,\n    content: output.body,\n    model_used: aiResult.usage?.model,\n    prompt_version: aiResult.prompt_version\n  }\n}];"
      },
      "id": "48460d99-5d64-488b-ab4f-eb7680ee0e48",
      "name": "Prepare Message Insert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -600,
        -150
      ]
    },
    {
      "parameters": {
