        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "f348a323-89a7-414d-9783-4afbf5231798",
      "name": "Insert Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -400,
        -150
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $('Normalize & Check Auth').first().json.channel }}",
              "rightValue": "email",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8488be4f-498c-4b7b-ae5d-5cfbe221388a",
      "name": "Is Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -200,
        -150
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "Bf5zMXhNSSrGxi93",
          "mode": "list",
          "cachedResultName": "KB - Customer Activity Analysis"
        },
        "options": {}
      },
      "id": "8488be4f-498c-4b7b-ae5d-5cfbe221388b",
      "name": "Refresh Customer Memory",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        -200,
        150
      ],
      "notes": "Phase 6 addition: generating a message is real customer activity, so it refreshes the AI's rolling customer_memory summary in parallel with the send/approval branch above - doesn't block or affect the webhook response."
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json;\nconst message = Array.isArray(rows) ? rows[0] : rows;\nconst schoolRows = $('Fetch School With Interactions').first().json;\nconst school = Array.isArray(schoolRows) ? schoolRows[0] : schoolRows;\n\nreturn [{\n  json: {\n    user_id: message.user_id,\n    action_type: 'send_email',\n    payload: {\n      generated_message_id: message.id,\n      to: school.email,\n      subject: message.subject,\n      body: message.content\n    },\n    related_record_type: 'generated_message',\n    related_record_id: message.id,\n    generated_message_id: message.id\n  }\n}];"
      },
      "id": "d68a50ed-be75-4b0a-865e-0e80df187cbe",
      "name": "Build Approval Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        -300
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "cvI1POuIPIfKsO8J",
          "mode": "list",
          "cachedResultName": "Core - Request Approval"
        },
        "options": {}
      },
      "id": "acdabb92-4d26-49b1-889e-2af895ddf4e3",
      "name": "Call Request Approval",
