        -1800,
        -150
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/schools",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "in.(contacted,demo_scheduled,demo_completed,negotiating,trial_started)"
            },
            {
              "name": "next_follow_up_date",
              "value": "is.null"
            },
            {
              "name": "updated_at",
              "value": "=lte.{{ new Date(Date.now() - 14 * 86400000).toISOString() }}"
            },
            {
              "name": "select",
              "value": "*"
            }
          ]
        },
        "options": {}
      },
      "id": "9a3f0160-8f06-4aac-ad12-b93868f4bf61",
      "name": "Fetch Stale No-Date",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1800,
        150
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Catches leads that were never given a follow-up date and have gone quiet 14+ days - two simple queries merged in code, rather than one compound OR/AND filter, to keep the query syntax low-risk.",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const due = $('Fetch Due Follow-ups').first().json || [];\nconst stale = $('Fetch Stale No-Date').first().json || [];\nconst seen = new Set();\nconst merged = [];\nfor (const s of [...due, ...stale]) {\n  if (!seen.has(s.id)) { seen.add(s.id); merged.push(s); }\n}\nreturn [{ json: { items: merged } }];"
      },
      "id": "cd44d5b0-fcbd-4608-bb8e-eb84e0599ca7",
      "name": "Merge & Dedupe Schools",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1600,
        0
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "id": "58d21df0-4c2d-4792-9fbb-9e2dda0d8473",
      "name": "Split Out Schools",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        -1400,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/school_interactions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "school_id",
              "value": "=eq.{{ $json.id }}"
            },
            {
              "name": "order",
              "value": "occurred_at.desc"
            },
            {
              "name": "limit",
              "value": "5"
            },
            {
              "name": "select",
              "value": "interaction_type,notes,occurred_at,objections"
            }
          ]
        },
        "options": {}
      },
      "id": "a88fbe9a-b0cb-47c1-8045-854b20eb2f99",
      "name": "Fetch Interaction History",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1200,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const school = $('Split Out Schools').item.json;\nconst interactions = $input.all().map(item => item.json).filter(item => item && Object.keys(item).length > 0) || [];\nconst daysSince = school.updated_at ? Math.round((Date.now() - new Date(school.updated_at).getTime()) / 86400000) : null;\n\nconst historyText = interactions.length\n  ? interactions.map(i => `- ${new Date(i.occurred_at).toLocaleDateString()} (${i.interaction_type}): ${i.notes || ''}`).join('\\n')\n  : 'No recorded interactions yet.';\n\nconst objectionsText = interactions.map(i => i.objections).filter(Boolean).join('; ') || 'None recorded.';\n\nreturn [{\n  json: {\n    prompt_key: 'crm_follow_up',\n    user_id: school.user_id,\n    feature: 'crm_follow_up',\n    related_record_type: 'school',\n    related_record_id: school.id,\n    variables: {\n      school_name: school.school_name,\n      status: school.status,\n      interest_level: school.interest_level,\n      days_since_last_contact: daysSince ?? 'unknown',\n      interaction_history: historyText,\n      objections: objectionsText\n    }\n  }\n}];"
      },
      "id": "cda1ecd7-43ae-40a8-b2cb-311bcc93df6a",
      "name": "Build AI Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1000,
        0
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "NScqkbAehRkYoqbX",
          "mode": "list",
          "cachedResultName": "AI - Process Request"
        },
        "options": {}
      },
      "id": "a4b51b47-8d06-4d4b-9134-e72098a939c7",
      "name": "Call AI - Process Request",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        -800,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const school = $('Split Out Schools').item.json;\nconst output = $input.first().json.output;\n\nreturn [{\n  json: {\n    user_id: school.user_id,\n    title: `Follow up: ${school.school_name}`,\n    description: output.suggested_action,\n    category: 'sales_followup',\n    priority: school.interest_level === 'hot' ? 'high' : 'medium',\n    due_date: output.suggested_follow_up_date,\n    related_school_id: school.id,\n    ai_suggested: true\n  }\n}];"
      },
      "id": "41ef28e0-3c86-4ca2-8121-5c107a172c5e",
