      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Advances next_follow_up_date so this same lead isn't re-caught by tomorrow's run.",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const school = $('Split Out Schools').item.json;\nconst aiResult = $input.first().json;\nconst output = aiResult.output;\nreturn [{\n  json: {\n    user_id: school.user_id,\n    school_id: school.id,\n    message_type: 'follow_up',\n    channel: 'whatsapp',\n    content: output.draft_message,\n    model_used: aiResult.usage?.model\n  }\n}];"
      },
