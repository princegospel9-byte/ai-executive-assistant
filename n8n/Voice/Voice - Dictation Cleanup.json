        "jsCode": "const input = $('Normalize & Check Auth').first().json;\nconst userId = $('Get Primary User').first().json.id;\nreturn [{\n  json: {\n    prompt_key: 'dictation_cleanup',\n    user_id: userId,\n    feature: 'dictation_cleanup',\n    variables: { target_type: input.target_type, raw_text: input.raw_text }\n  }\n}];"
      },
