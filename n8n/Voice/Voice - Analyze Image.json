{
  "name": "Voice - Analyze Image",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "analyze-image",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "j9j9e9f9-0009-4009-8009-000000000001",
      "name": "Called From Dashboard (Analyze Image)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1600, 0],
      "notes": "Requires header x-automation-secret. Body: { media_id, image_data (base64, no data: prefix), image_media_type, question? }. Next.js sends the image bytes directly rather than n8n re-fetching from Storage - avoids needing signed-URL logic here."
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.body || {};\nconst providedSecret = item.headers?.['x-automation-secret'] || item.headers?.['X-Automation-Secret'];\nconst authOk = providedSecret === $vars.N8N_WEBHOOK_SECRET;\nreturn [{\n  json: {\n    media_id: payload.media_id,\n    image_data: payload.image_data,\n    image_media_type: payload.image_media_type || 'image/jpeg',\n    question: payload.question || 'Describe this image in detail, so it can be found later by searching for what it shows.',\n    auth_ok: authOk\n  }\n}];"
      },
      "id": "j9j9e9f9-0009-4009-8009-000000000002",
      "name": "Normalize & Check Auth",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1400, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.auth_ok }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "j9j9e9f9-0009-4009-8009-000000000003",
      "name": "Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-1200, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, error: 'Unauthorized' } }}",
        "options": { "responseCode": 401 }
      },
      "id": "j9j9e9f9-0009-4009-8009-000000000004",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-1000, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/uploaded_media",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "id", "value": "=eq.{{ $('Normalize & Check Auth').first().json.media_id }}" },
            { "name": "select", "value": "user_id" }
          ]
        },
        "options": {}
      },
      "id": "j9j9e9f9-0009-4009-8009-000000000005",
      "name": "Fetch Media Record",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1000, -150],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json;\nconst media = Array.isArray(rows) ? rows[0] : rows;\nif (!media) {\n  throw new Error('Media record not found: ' + $('Normalize & Check Auth').first().json.media_id);\n}\nconst input = $('Normalize & Check Auth').first().json;\nreturn [{\n  json: {\n    prompt_key: 'image_analysis',\n    user_id: media.user_id,\n    feature: 'image_analysis',\n    related_record_type: 'uploaded_media',\n    related_record_id: input.media_id,\n    image_data: input.image_data,\n    image_media_type: input.image_media_type,\n    media_id: input.media_id,\n    variables: { question: input.question }\n  }\n}];"
      },
      "id": "j9j9e9f9-0009-4009-8009-000000000006",
      "name": "Build AI Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-800, -150]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "AI - Process Request"
        },
        "options": {}
      },
      "id": "j9j9e9f9-0009-4009-8009-000000000007",
      "name": "Call AI - Process Request",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [-600, -150]
    },
    {
      "parameters": {
        "jsCode": "const aiResult = $input.first().json;\nconst built = $('Build AI Request').first().json;\nconst description = aiResult.raw_text || (typeof aiResult.output === 'string' ? aiResult.output : JSON.stringify(aiResult.output));\nreturn [{ json: { media_id: built.media_id, description } }];"
      },
      "id": "j9j9e9f9-0009-4009-8009-000000000008",
      "name": "Prepare Media Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-400, -150]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/uploaded_media",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{ "name": "id", "value": "=eq.{{ $json.media_id }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ description: $json.description, status: 'ready' }) }}",
        "options": {}
      },
      "id": "j9j9e9f9-0009-4009-8009-000000000009",
      "name": "Update Media Record",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-200, -150],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const prep = $('Prepare Media Update').first().json;\nreturn [{ json: { success: true, description: prep.description } }];"
      },
      "id": "j9j9e9f9-0009-4009-8009-00000000000a",
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, -150]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": { "responseCode": 200 }
      },
      "id": "j9j9e9f9-0009-4009-8009-00000000000b",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [200, -150]
    }
  ],
  "connections": {
    "Called From Dashboard (Analyze Image)": {
      "main": [[{ "node": "Normalize & Check Auth", "type": "main", "index": 0 }]]
    },
    "Normalize & Check Auth": {
      "main": [[{ "node": "Authorized?", "type": "main", "index": 0 }]]
    },
    "Authorized?": {
      "main": [
        [{ "node": "Fetch Media Record", "type": "main", "index": 0 }],
        [{ "node": "Respond 401", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Media Record": {
      "main": [[{ "node": "Build AI Request", "type": "main", "index": 0 }]]
    },
    "Build AI Request": {
      "main": [[{ "node": "Call AI - Process Request", "type": "main", "index": 0 }]]
    },
    "Call AI - Process Request": {
      "main": [[{ "node": "Prepare Media Update", "type": "main", "index": 0 }]]
    },
    "Prepare Media Update": {
      "main": [[{ "node": "Update Media Record", "type": "main", "index": 0 }]]
    },
    "Update Media Record": {
      "main": [[{ "node": "Build Response", "type": "main", "index": 0 }]]
    },
    "Build Response": {
      "main": [[{ "node": "Respond 200", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": ""
  },
  "pinData": {}
}