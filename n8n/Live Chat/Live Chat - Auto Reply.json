        "jsCode": "const c = $('Check Confidence').first().json;\nreturn [{\n  json: {\n    user_id: $('Get Primary User').first().json.id,\n    title: 'Live chat needs your reply',\n    message: `A school admin asked: \"${c.question}\" - the AI wasn't confident enough to auto-reply. Open Live Chat to answer.`,\n    severity: 'warning',\n    channel: 'in_app',\n    related_record_type: 'live_chat_message',\n    related_record_id: c.message_id\n  }\n}];"
