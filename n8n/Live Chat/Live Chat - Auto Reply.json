      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.body || {};\nconst providedSecret = item.headers?.['x-schoolhub-secret'] || item.headers?.['X-Schoolhub-Secret'];\nconst authOk = providedSecret === $env.SCHOOLHUB_WEBHOOK_SECRET;\nreturn [{ json: { message_id: payload.message_id, school_id: payload.school_id, session_id: payload.session_id, sender_name: payload.sender_name || '', message: payload.message || '', auth_ok: authOk } }];"
