        "options": {}
      },
      "id": "lc10",
      "name": "Call AI - Process Request",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        -1000,
        -150
      ]
    },
    {
      "parameters": {
        "jsCode": "const aiResult = $('Call AI - Process Request').first().json;\nconst context = $('Build Retrieved Context').first().json;\nconst parsed = aiResult.output || {};\n// Belt-and-suspenders: require BOTH Claude's self-reported confidence AND a\n// real vector-similarity floor - never rely on the model's self-report alone\n// for something that can auto-reply to a real customer with no review.\nconst confident = parsed.confident === true && context.top_similarity >= 0.5;\nreturn [{\n  json: {\n    confident,\n    answer: parsed.answer || '',\n    message_id: $('Normalize & Check Auth').first().json.message_id,\n    school_id: $('Normalize & Check Auth').first().json.school_id,\n    session_id: $('Normalize & Check Auth').first().json.session_id,\n    question: context.question\n  }\n}];"
      },
