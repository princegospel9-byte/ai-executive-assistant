        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query_embedding: $json.data[0].embedding, match_user_id: $('Get Primary User').first().json.id, match_count: 6 }) }}",
        "options": {}
      },
      "id": "lc07",
      "name": "Vector Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1600,
        -150
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const chunks = $('Vector Search').all().map(item => item.json).filter(item => item && Object.keys(item).length > 0);\nconst topSimilarity = chunks.length ? Math.max(...chunks.map(c => c.similarity || 0)) : 0;\nconst retrievedContext = chunks.length\n  ? chunks.map(c => `- ${c.content}`).join('\\n\\n')\n  : 'No relevant product documentation found.';\nreturn [{\n  json: {\n    question: $('Normalize & Check Auth').first().json.message,\n    user_id: $('Get Primary User').first().json.id,\n    retrieved_context: retrievedContext,\n    top_similarity: topSimilarity,\n    chunk_count: chunks.length\n  }\n}];"
      },
      "id": "lc08",
      "name": "Build Retrieved Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1400,
        -150
      ],
      "notes": "Deliberately documentation-only (no business_memory/pipeline/tasks blend like KB - Answer Question) - this reply goes to a real customer, not Prince, so it must never leak internal business data."
    },
    {
      "parameters": {
        "jsCode": "const context = $('Build Retrieved Context').first().json;\nreturn [{\n  json: {\n    prompt_key: 'live_chat_reply',\n    user_id: context.user_id,\n    feature: 'live_chat_autoreply',\n    variables: {\n      question: context.question,\n      retrieved_context: context.retrieved_context\n    }\n  }\n}];"
      },
      "id": "lc09",
      "name": "Build AI Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1200,
        -150
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
