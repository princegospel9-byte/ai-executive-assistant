{
  "name": "Tasks - Create From Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "task-create-from-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "4d8ed0b2-9f28-4352-bd99-18566c36384f",
      "name": "Called From Dashboard (Create Task)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1200,
        0
      ],
      "notes": "Requires header x-automation-secret. Body: { email_id }. Builds the task directly from the email's existing analysis - no extra Claude call needed.",
      "webhookId": "9f00ecf2-721e-47d7-9f77-a1ff6e2424e8"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.body || {};\nconst providedSecret = item.headers?.['x-automation-secret'] || item.headers?.['X-Automation-Secret'];\nconst authOk = providedSecret === $env.N8N_WEBHOOK_SECRET;\nreturn [{ json: { email_id: payload.email_id, auth_ok: authOk } }];"
      },
      "id": "8c206c48-b8a6-4bcc-8aff-648fc06cb530",
      "name": "Normalize & Check Auth",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1000,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.auth_ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2b2f21d0-2a45-4211-9649-22a1df34af88",
      "name": "Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -800,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, error: 'Unauthorized' } }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "fbe03ce0-d533-423e-9fee-ef3fb7373cc3",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -600,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "=eq.{{ $('Normalize & Check Auth').first().json.email_id }}"
            },
            {
              "name": "select",
              "value": "*,email_analysis(*)"
            }
          ]
        },
        "options": {}
      },
      "id": "c5af3bb9-c23d-4ac4-a466-4aef2aa95450",
      "name": "Fetch Email With Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -600,
        -150
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json;\nconst email = Array.isArray(rows) ? rows[0] : rows;\nif (!email || Object.keys(email).length === 0) {\n  throw new Error('Email not found for id: ' + $('Normalize & Check Auth').first().json.email_id);\n}\nconst analysisRaw = email.email_analysis;\nconst analysis = Array.isArray(analysisRaw) ? analysisRaw[0] : analysisRaw;\n\nconst title = analysis?.suggested_next_step\n  ? analysis.suggested_next_step.slice(0, 120)\n  : `Follow up: ${email.subject || email.from_address}`;\n\nreturn [{\n  json: {\n    user_id: email.user_id,\n    title,\n    description: analysis?.summary || null,\n    category: analysis?.category || null,\n    priority: analysis?.priority || 'medium',\n    ai_priority_reason: analysis?.priority_reason || null,\n    due_date: analysis?.suggested_deadline || null,\n    related_email_id: email.id,\n    contact_id: email.contact_id || null,\n    ai_suggested: true\n  }\n}];"
      },
      "id": "ffa62ab2-f7a4-4148-baa4-43ab0c4add86",
      "name": "Prepare Task From Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        -150
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/tasks",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "1b6cb84e-122f-4178-9289-aedffd777df2",
      "name": "Insert Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -200,
        -150
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json;\nconst task = Array.isArray(rows) ? rows[0] : rows;\nreturn [{ json: { success: true, task_id: task.id, title: task.title, priority: task.priority, due_date: task.due_date } }];"
      },
      "id": "c23d011d-9a00-4478-ba15-6e24d02bea09",
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        -150
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "3633a81d-3a77-4b00-aa23-c19e8d9d4adc",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        200,
        -150
      ]
    }
  ],
