        "jsCode": "const rows = $input.first().json;\nconst task = Array.isArray(rows) ? rows[0] : rows;\nconst prepared = $('Prepare Task Insert').first().json;\nif (!prepared.reminder_at) return [];\nreturn [{\n  json: {\n    user_id: task.user_id,\n    task_id: task.id,\n    remind_at: prepared.reminder_at,\n    notification_type: 'in_app'\n  }\n}];"
