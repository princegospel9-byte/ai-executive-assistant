    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst dayNames = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];\nconst userId = $('Get Primary User').first().json.id;\nconst text = $('Normalize & Check Auth').first().json.text;\n\nreturn [{\n  json: {\n    prompt_key: 'natural_language_task',\n    user_id: userId,\n    feature: 'natural_language_task',\n    variables: {\n      text,\n      current_date: now.toISOString().split('T')[0],\n      current_day_name: dayNames[now.getDay()]\n    }\n  }\n}];"
      },
      "id": "1faf54a0-0c5e-4300-8235-1638c01e5bf5",
      "name": "Build AI Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1000,
        -150
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "NScqkbAehRkYoqbX",
          "mode": "list",
          "cachedResultName": "AI - Process Request"
        },
        "options": {}
      },
      "id": "e3029b83-afd7-4b70-aee5-5e7dffe57ab3",
      "name": "Call AI - Process Request",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        -800,
        -150
      ]
    },
    {
      "parameters": {
        "jsCode": "const aiResult = $input.first().json;\nconst output = aiResult.output;\nconst userId = $('Build AI Request').first().json.user_id;\n\nfunction computeNextRun(type, day, time) {\n  const [h, m] = (time || '09:00').split(':').map(Number);\n  const now = new Date();\n  const next = new Date(now);\n  next.setHours(h, m, 0, 0);\n\n  if (type === 'daily') {\n    if (next <= now) next.setDate(next.getDate() + 1);\n  } else if (type === 'weekly') {\n    const targetDay = day ?? 1;\n    let diff = (targetDay - next.getDay() + 7) % 7;\n    if (diff === 0 && next <= now) diff = 7;\n    next.setDate(next.getDate() + diff);\n  } else if (type === 'monthly') {\n    const targetDay = day ?? 1;\n    next.setDate(targetDay);\n    if (next <= now) next.setMonth(next.getMonth() + 1);\n  }\n  return next.toISOString();\n}\n\nif (output.is_recurring) {\n  return [{\n    json: {\n      _kind: 'recurring',\n      user_id: userId,\n      title: output.title,\n      description: output.description,\n      category: output.category,\n      priority: output.priority,\n      recurrence_type: output.recurrence_type,\n      recurrence_day: output.recurrence_day,\n      recurrence_time: output.recurrence_time || '09:00',\n      next_run_at: computeNextRun(output.recurrence_type, output.recurrence_day, output.recurrence_time)\n    }\n  }];\n}\n\nlet dueDate = null;\nif (output.due_date) {\n  dueDate = output.due_time ? `${output.due_date}T${output.due_time}:00` : `${output.due_date}T17:00:00`;\n}\n\nlet reminderAt = null;\nif (dueDate && output.reminder_offset_minutes) {\n  reminderAt = new Date(new Date(dueDate).getTime() - output.reminder_offset_minutes * 60000).toISOString();\n}\n\nreturn [{\n  json: {\n    _kind: 'oneoff',\n    user_id: userId,\n    title: output.title,\n    description: output.description,\n    category: output.category,\n    priority: output.priority,\n    ai_priority_reason: output.priority_reason,\n    due_date: dueDate,\n    reminder_at: reminderAt,\n    ai_suggested: true\n  }\n}];"
      },
