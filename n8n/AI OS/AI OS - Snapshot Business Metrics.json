{
  "name": "AI OS - Snapshot Business Metrics",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "days", "daysInterval": 1, "triggerAtHour": 23, "triggerAtMinute": 45 }] }
      },
      "id": "o4o4d4e4-0014-4014-8014-000000000001",
      "name": "Every Day at 11:45 PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1800, 0],
      "notes": "Late in the day so the snapshot reflects the whole day's activity. Feeds business_predictions and the Command Center's revenue trend."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/profiles",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "id" },
            { "name": "limit", "value": "1" }
          ]
        },
        "options": {}
      },
      "id": "o4o4d4e4-0014-4014-8014-000000000002",
      "name": "Get Primary User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1600, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/schools",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{ "name": "select", "value": "status" }]
        },
        "options": {}
      },
      "id": "o4o4d4e4-0014-4014-8014-000000000003",
      "name": "Fetch Schools",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1400, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/finance_entries",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "occurred_on", "value": "=gte.{{ new Date(new Date().getFullYear(), new Date().getMonth(), 1).toISOString().split('T')[0] }}" },
            { "name": "select", "value": "entry_type,amount,currency" }
          ]
        },
        "options": {}
      },
      "id": "o4o4d4e4-0014-4014-8014-000000000004",
      "name": "Fetch Finance This Month",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1200, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Single-currency simplification: totals assume one currency (GHS) - a mixed-currency month would understate/overstate this snapshot. Documented, not silently wrong."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/tasks",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{ "name": "select", "value": "status" }]
        },
        "options": {}
      },
      "id": "o4o4d4e4-0014-4014-8014-000000000005",
      "name": "Fetch Tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1000, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const schools = $('Fetch Schools').first().json || [];\nconst finance = $('Fetch Finance This Month').first().json || [];\nconst tasks = $input.first().json || [];\nconst userId = $('Get Primary User').first().json[0].id;\n\nconst totalCustomers = schools.filter(s => s.status === 'customer').length;\nconst activeLeads = schools.filter(s => s.status !== 'customer' && s.status !== 'lost_lead').length;\nconst incomeTotal = finance.filter(f => f.entry_type === 'income').reduce((sum, f) => sum + Number(f.amount), 0);\nconst expenseTotal = finance.filter(f => f.entry_type === 'expense').reduce((sum, f) => sum + Number(f.amount), 0);\nconst tasksCompleted = tasks.filter(t => t.status === 'completed').length;\nconst tasksPending = tasks.filter(t => t.status === 'pending' || t.status === 'in_progress').length;\n\nreturn [{\n  json: {\n    user_id: userId,\n    metric_date: new Date().toISOString().split('T')[0],\n    total_customers: totalCustomers,\n    active_leads: activeLeads,\n    income_total: incomeTotal,\n    expense_total: expenseTotal,\n    tasks_completed: tasksCompleted,\n    tasks_pending: tasksPending\n  }\n}];"
      },
      "id": "o4o4d4e4-0014-4014-8014-000000000006",
      "name": "Build Snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-800, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/business_metrics?on_conflict=user_id,metric_date",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "resolution=merge-duplicates,return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "o4o4d4e4-0014-4014-8014-000000000007",
      "name": "Upsert Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-600, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Every Day at 11:45 PM": {
      "main": [[{ "node": "Get Primary User", "type": "main", "index": 0 }]]
    },
    "Get Primary User": {
      "main": [[{ "node": "Fetch Schools", "type": "main", "index": 0 }]]
    },
    "Fetch Schools": {
      "main": [[{ "node": "Fetch Finance This Month", "type": "main", "index": 0 }]]
    },
    "Fetch Finance This Month": {
      "main": [[{ "node": "Fetch Tasks", "type": "main", "index": 0 }]]
    },
    "Fetch Tasks": {
      "main": [[{ "node": "Build Snapshot", "type": "main", "index": 0 }]]
    },
    "Build Snapshot": {
      "main": [[{ "node": "Upsert Snapshot", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "",
    "timezone": "Africa/Accra"
  },
  "pinData": {}
}