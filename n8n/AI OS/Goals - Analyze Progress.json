{
  "name": "Goals - Analyze Progress",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "goals-analyze-progress",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "m2m2b2c2-0012-4012-8012-000000000001",
      "name": "Called From Dashboard (Analyze Goal)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-2000, 0],
      "notes": "Requires header x-automation-secret. Body: { goal_id }."
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.body || {};\nconst providedSecret = item.headers?.['x-automation-secret'] || item.headers?.['X-Automation-Secret'];\nconst authOk = providedSecret === $vars.N8N_WEBHOOK_SECRET;\nreturn [{ json: { goal_id: payload.goal_id, auth_ok: authOk } }];"
      },
      "id": "m2m2b2c2-0012-4012-8012-000000000002",
      "name": "Normalize & Check Auth",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1800, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.auth_ok }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "m2m2b2c2-0012-4012-8012-000000000003",
      "name": "Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-1600, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, error: 'Unauthorized' } }}",
        "options": { "responseCode": 401 }
      },
      "id": "m2m2b2c2-0012-4012-8012-000000000004",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-1400, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/company_goals",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "id", "value": "=eq.{{ $('Normalize & Check Auth').first().json.goal_id }}" },
            { "name": "select", "value": "*" }
          ]
        },
        "options": {}
      },
      "id": "m2m2b2c2-0012-4012-8012-000000000005",
      "name": "Fetch Goal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1400, -150],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/goal_progress",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "goal_id", "value": "=eq.{{ $('Normalize & Check Auth').first().json.goal_id }}" },
            { "name": "order", "value": "recorded_at.desc" },
            { "name": "limit", "value": "10" },
            { "name": "select", "value": "current_value,note,recorded_at" }
          ]
        },
        "options": {}
      },
      "id": "m2m2b2c2-0012-4012-8012-000000000006",
      "name": "Fetch Progress History",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1200, -150],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/schools",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "status", "value": "eq.customer" },
            { "name": "select", "value": "id" }
          ]
        },
        "options": {}
      },
      "id": "m2m2b2c2-0012-4012-8012-000000000007",
      "name": "Fetch Customer Count",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1000, -150],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Only meaningfully used when the goal's goal_type is 'customer_count' - computed regardless since it's a cheap query, ignored otherwise."
    },
    {
      "parameters": {
        "jsCode": "const goalRows = $('Fetch Goal').first().json;\nconst goal = Array.isArray(goalRows) ? goalRows[0] : goalRows;\nif (!goal) {\n  throw new Error('Goal not found: ' + $('Normalize & Check Auth').first().json.goal_id);\n}\nconst history = $('Fetch Progress History').first().json || [];\nconst customers = $input.first().json || [];\n\nlet currentValue;\nif (goal.goal_type === 'customer_count') {\n  currentValue = customers.length;\n} else if (history.length && history[0].current_value !== null) {\n  currentValue = history[0].current_value;\n} else {\n  currentValue = null;\n}\n\nconst historyText = history.length\n  ? history.map(h => `- ${new Date(h.recorded_at).toLocaleDateString()}: ${h.current_value ?? 'no value'}${h.note ? ' - ' + h.note : ''}`).join('\\n')\n  : 'No progress history recorded yet.';\n\nreturn [{\n  json: {\n    prompt_key: 'goal_progress_analysis',\n    user_id: goal.user_id,\n    feature: 'goal_progress_analysis',\n    related_record_type: 'company_goal',\n    related_record_id: goal.id,\n    goal_id: goal.id,\n    current_value: currentValue,\n    variables: {\n      title: goal.title,\n      target_value: goal.target_value ?? 'not set',\n      target_date: goal.target_date ?? 'not set',\n      current_value: currentValue ?? 'unknown',\n      progress_history: historyText\n    }\n  }\n}];"
      },
      "id": "m2m2b2c2-0012-4012-8012-000000000008",
      "name": "Build AI Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-800, -150]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "AI - Process Request"
        },
        "options": {}
      },
      "id": "m2m2b2c2-0012-4012-8012-000000000009",
      "name": "Call AI - Process Request",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [-600, -150]
    },
    {
      "parameters": {
        "jsCode": "const aiResult = $input.first().json;\nconst built = $('Build AI Request').first().json;\nconst output = aiResult.output || {};\nreturn [{\n  json: {\n    user_id: built.user_id,\n    goal_id: built.goal_id,\n    current_value: built.current_value,\n    note: `${output.analysis} Blockers: ${(output.blockers || []).join('; ') || 'none identified'}. Recommended: ${(output.recommended_actions || []).join('; ')}. Predicted completion: ${output.predicted_completion}.`,\n    analysis: output.analysis,\n    blockers: output.blockers || [],\n    recommended_actions: output.recommended_actions || [],\n    predicted_completion: output.predicted_completion\n  }\n}];"
      },
      "id": "m2m2b2c2-0012-4012-8012-00000000000a",
      "name": "Prepare Progress Insert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-400, -150]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/goal_progress",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ user_id: $json.user_id, goal_id: $json.goal_id, current_value: $json.current_value, note: $json.note }) }}",
        "options": {}
      },
      "id": "m2m2b2c2-0012-4012-8012-00000000000b",
      "name": "Insert Progress Entry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-200, -150],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const prep = $('Prepare Progress Insert').first().json;\nreturn [{ json: { success: true, analysis: prep.analysis, blockers: prep.blockers, recommended_actions: prep.recommended_actions, predicted_completion: prep.predicted_completion, current_value: prep.current_value } }];"
      },
      "id": "m2m2b2c2-0012-4012-8012-00000000000c",
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, -150]
    },
    {
      "parameters": {
        "respondWith": "json",
