      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.body || {};\nconst providedSecret = item.headers?.['x-automation-secret'] || item.headers?.['X-Automation-Secret'];\nconst authOk = providedSecret === $env.N8N_WEBHOOK_SECRET;\nconst reportType = payload.report_type === 'annual' ? 'annual' : 'quarterly';\nreturn [{ json: { report_type: reportType, months_back: reportType === 'annual' ? 12 : 3, auth_ok: authOk, from_webhook: true } }];"
      },
