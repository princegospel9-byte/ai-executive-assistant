    {
      "parameters": {
        "jsCode": "const trigger = $('Authorized?').first().json;\nconst schools = $('Fetch All Schools').all().map(item => item.json).filter(item => item && Object.keys(item).length > 0) || [];\nconst metrics = $('Fetch Metrics History').all().map(item => item.json).filter(item => item && Object.keys(item).length > 0) || [];\nconst goals = $('Fetch Active Goals').all().map(item => item.json).filter(item => item && Object.keys(item).length > 0) || [];\nconst revenue = $input.all().map(item => item.json).filter(item => item && Object.keys(item).length > 0) || [];\n\nconst now = new Date();\nconst periodStart = new Date(now.getFullYear(), now.getMonth() - trigger.months_back, 1);\nconst periodEnd = new Date(now.getFullYear(), now.getMonth(), 0);\nconst periodLabel = trigger.report_type === 'annual'\n  ? `${periodStart.getFullYear()}`\n  : `Q covering ${periodStart.toLocaleDateString(undefined, { month: 'short', year: 'numeric' })} - ${periodEnd.toLocaleDateString(undefined, { month: 'short', year: 'numeric' })}`;\n\nconst pipelineCounts = schools.reduce((acc, s) => { acc[s.status] = (acc[s.status] || 0) + 1; return acc; }, {});\nconst pipelineText = Object.entries(pipelineCounts).map(([status, count]) => `- ${status}: ${count}`).join('\\n') || 'No pipeline data.';\n\nconst periodMetrics = metrics.filter(m => new Date(m.metric_date) >= periodStart);\nconst metricsText = periodMetrics.length\n  ? periodMetrics.map(m => `- ${m.metric_date}: income ${m.income_total}, expenses ${m.expense_total}, customers ${m.total_customers}`).join('\\n')\n  : 'No metric snapshots for this period yet.';\n\nconst goalsText = goals.length\n  ? goals.map(g => `- ${g.title} (target: ${g.target_value ?? 'n/a'} by ${g.target_date ?? 'n/a'})`).join('\\n')\n  : 'No active goals set.';\n\nconst revenueText = revenue.length ? revenue.map(r => `- ${r.key}: ${r.value}`).join('\\n') : 'Not tracked via business memory - see finance entries above if any.';\n\nreturn [{\n  json: {\n    user_id: $('Get Primary User').first().json.id,\n    report_type: trigger.report_type,\n    period_start: periodStart.toISOString().split('T')[0],\n    period_end: periodEnd.toISOString().split('T')[0],\n    period_label: periodLabel,\n    pipeline_movement: pipelineText,\n    metrics_history: metricsText,\n    goal_progress_summary: goalsText,\n    revenue_notes: revenueText,\n    pipeline_counts: pipelineCounts\n  }\n}];"
      },
