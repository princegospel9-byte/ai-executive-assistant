        "jsCode": "const aiResult = $input.first().json;\nconst input = $('Build Report Input').first().json;\nconst output = aiResult.output || {};\nreturn [{\n  json: {\n    user_id: input.user_id,\n    report_type: input.report_type,\n    period_start: input.period_start,\n    period_end: input.period_end,\n    content_text: output.report_text,\n    content_json: { pipeline_counts: input.pipeline_counts },\n    insights: output.insights || []\n  }\n}];"
