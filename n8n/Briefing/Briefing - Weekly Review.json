      },
      "id": "f42ad65c-8cd3-406c-96a1-edd234dcfe59",
      "name": "Call AI - Process Request",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [-400, 0]
    },
    {
      "parameters": {
        "jsCode": "const aiResult = $input.first().json;\nconst input = $('Build Review Input').first().json;\nconst userId = $('Get Primary User').first().json[0].id;\n\nreturn [{\n  json: {\n    user_id: userId,\n    week_start_date: input.week_start_date,\n    content_text: aiResult.output,\n    content_json: { completed_count: input.completed_count, pending_count: input.pending_count, new_leads_count: input.new_leads_count, pipeline_counts: input.pipeline_counts },\n    sent_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "a282cee7-a02e-47ec-bc4e-d910ea59e7ad",
      "name": "Prepare Review Insert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-200, 0]
