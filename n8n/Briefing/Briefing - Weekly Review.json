      "id": "af7ca9f5-9311-47f1-9057-cae2327572ca",
      "name": "Upsert Weekly Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json;\nconst review = Array.isArray(rows) ? rows[0] : rows;\nreturn [{\n  json: {\n    user_id: review.user_id,\n    title: 'Your weekly review is ready',\n    message: review.content_text.slice(0, 200),\n    severity: 'info',\n    channel: 'in_app',\n    related_record_type: 'weekly_review',\n    related_record_id: review.id\n  }\n}];"
      },
