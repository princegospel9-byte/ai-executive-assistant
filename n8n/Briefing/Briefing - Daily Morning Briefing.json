      },
      "id": "cb20ecb9-951b-4baf-92ed-e1947fe8ab24",
      "name": "Every Day at 6:00 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-2400, 0],
      "notes": "Interpreted in this workflow's timezone setting (Africa/Accra) - set under Settings after import if it doesn't carry over from this JSON."
    },
    {
      "parameters": {
