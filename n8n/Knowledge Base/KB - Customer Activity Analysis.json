      "name": "When Called (from Generate Message)",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -2200,
        -150
      ],
      "notes": "Expected input: { school_id }. Called two ways - as a sub-workflow right after School CRM - Generate Message inserts a message (automatic trigger on real customer activity), and via the webhook below (manual 'Refresh AI summary' button on the school detail page)."
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kb-customer-activity",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c3c3d3e3-0003-4003-8003-000000000002",
      "name": "Called From Dashboard (Refresh Summary)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -2200,
        150
      ],
      "notes": "Requires header x-automation-secret. Body: { school_id }.",
      "webhookId": "81bec0e4-d819-4eba-a1f0-a4315d05b190"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.body || item;\nconst providedSecret = item.headers?.['x-automation-secret'] || item.headers?.['X-Automation-Secret'];\n// Sub-workflow calls (no headers) are always trusted - only webhook calls need the secret check.\nconst authOk = item.headers ? providedSecret === $env.N8N_WEBHOOK_SECRET : true;\nreturn [{ json: { school_id: payload.school_id, auth_ok: authOk, from_webhook: !!item.headers } }];"
      },
      "id": "c3c3d3e3-0003-4003-8003-000000000003",
      "name": "Normalize & Check Auth",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2000,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.auth_ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3c3d3e3-0003-4003-8003-000000000004",
      "name": "Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -1800,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, error: 'Unauthorized' } }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "c3c3d3e3-0003-4003-8003-000000000005",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -1600,
        250
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/schools",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "=eq.{{ $('Normalize & Check Auth').first().json.school_id }}"
            },
            {
              "name": "select",
              "value": "*,school_interactions(interaction_type,notes,next_action,occurred_at),generated_messages(message_type,channel,content,created_at)"
            }
          ]
        },
        "options": {}
      },
      "id": "c3c3d3e3-0003-4003-8003-000000000006",
      "name": "Fetch School With History",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1600,
        -150
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/customer_memory",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "school_id",
              "value": "=eq.{{ $('Normalize & Check Auth').first().json.school_id }}"
            },
            {
              "name": "select",
              "value": "summary"
            }
          ]
        },
        "options": {}
      },
      "id": "c3c3d3e3-0003-4003-8003-000000000007",
      "name": "Fetch Existing Memory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1400,
        -150
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const rows = $('Fetch School With History').first().json;\nconst school = Array.isArray(rows) ? rows[0] : rows;\nif (!school || Object.keys(school).length === 0) {\n  throw new Error('School not found: ' + $('Normalize & Check Auth').first().json.school_id);\n}\nconst existingRows = $input.first().json;\nconst existing = (Array.isArray(existingRows) ? existingRows[0] : existingRows)?.summary || 'None yet.';\n\nconst interactions = (school.school_interactions || []).slice(0, 8);\nconst interactionText = interactions.length\n  ? interactions.map(i => `- ${new Date(i.occurred_at).toLocaleDateString()} (${i.interaction_type}): ${i.notes || ''}`).join('\\n')\n  : 'No recorded interactions.';\n\nconst messages = (school.generated_messages || []).slice(0, 5);\nconst messagesText = messages.length\n  ? messages.map(m => `- ${new Date(m.created_at).toLocaleDateString()} (${m.channel}, ${m.message_type})`).join('\\n')\n  : 'No messages generated yet.';\n\nreturn [{\n  json: {\n    user_id: school.user_id,\n    school_id: school.id,\n    prompt_key: 'customer_memory_update',\n    feature: 'customer_memory',\n    related_record_type: 'school',\n    related_record_id: school.id,\n    variables: {\n      school_name: school.school_name,\n      status: school.status,\n      existing_summary: existing,\n      interaction_history: interactionText,\n      recent_messages: messagesText\n    }\n  }\n}];"
      },
      "id": "c3c3d3e3-0003-4003-8003-000000000008",
      "name": "Build AI Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1200,
        -150
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "NScqkbAehRkYoqbX",
          "mode": "list",
          "cachedResultName": "AI - Process Request"
        },
        "options": {}
      },
      "id": "c3c3d3e3-0003-4003-8003-000000000009",
      "name": "Call AI - Process Request",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        -1000,
        -150
      ]
    },
    {
      "parameters": {
        "jsCode": "const aiResult = $input.first().json;\nconst output = aiResult.output;\nconst built = $('Build AI Request').first().json;\nreturn [{\n  json: {\n    user_id: built.user_id,\n    school_id: built.school_id,\n    summary: output.summary,\n    preferences: output.preferences || null,\n    last_updated: new Date().toISOString(),\n    recommended_next_action: output.recommended_next_action\n  }\n}];"
      },
      "id": "c3c3d3e3-0003-4003-8003-00000000000a",
      "name": "Prepare Memory Upsert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -800,
        -150
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/customer_memory?on_conflict=user_id,school_id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ user_id: $json.user_id, school_id: $json.school_id, summary: $json.summary, preferences: $json.preferences, last_updated: $json.last_updated }) }}",
        "options": {}
      },
      "id": "c3c3d3e3-0003-4003-8003-00000000000b",
      "name": "Upsert Customer Memory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -600,
        -150
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const memory = $('Prepare Memory Upsert').first().json;\nreturn [{ json: { success: true, school_id: memory.school_id, summary: memory.summary, preferences: memory.preferences, recommended_next_action: memory.recommended_next_action } }];"
      },
