          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ input: [$('Normalize & Check Auth').first().json.question], model: 'voyage-3.5', input_type: 'query' }) }}",
        "options": {}
      },
      "id": "b2b2c2d2-0002-4002-8002-000000000006",
      "name": "Embed Question",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1600, -150],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/rpc/match_document_chunks",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query_embedding: $json.data[0].embedding, match_user_id: $('Get Primary User').first().json[0].id, match_count: 6 }) }}",
        "options": {}
      },
      "id": "b2b2c2d2-0002-4002-8002-000000000007",
      "name": "Vector Search",
      "type": "n8n-nodes-base.httpRequest",
