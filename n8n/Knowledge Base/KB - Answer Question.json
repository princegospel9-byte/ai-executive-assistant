      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/business_memory",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{ "name": "select", "value": "category,key,value" }]
        },
        "options": {}
      },
      "id": "b2b2c2d2-0002-4002-8002-000000000008",
      "name": "Fetch Business Memory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1200, -150],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/schools",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "status", "value": "neq.lost_lead" },
            { "name": "order", "value": "updated_at.desc" },
            { "name": "select", "value": "school_name,status,interest_level,next_follow_up_date" }
          ]
        },
        "options": {}
      },
      "id": "b2b2c2d2-0002-4002-8002-000000000009",
      "name": "Fetch Active Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1000, -150],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/tasks",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "status", "value": "in.(pending,in_progress)" },
            { "name": "order", "value": "priority.desc" },
            { "name": "limit", "value": "15" },
            { "name": "select", "value": "title,priority,due_date" }
          ]
        },
        "options": {}
      },
      "id": "b2b2c2d2-0002-4002-8002-00000000000a",
      "name": "Fetch Pending Tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-800, -150],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const chunks = $('Vector Search').first().json || [];\nconst memory = $('Fetch Business Memory').first().json || [];\nconst pipeline = $('Fetch Active Pipeline').first().json || [];\nconst tasks = $('Fetch Pending Tasks').first().json || [];\n\nconst docSection = chunks.length\n  ? 'Relevant document excerpts:\\n' + chunks.map(c => `- ${c.content}`).join('\\n\\n')\n  : 'No relevant document excerpts found.';\n\nconst memorySection = memory.length\n  ? 'Business memory:\\n' + memory.map(m => `- [${m.category}] ${m.key}: ${m.value}`).join('\\n')\n  : 'No business memory saved yet.';\n\nconst pipelineSection = pipeline.length\n  ? 'Current sales pipeline (active leads):\\n' + pipeline.map(s => `- ${s.school_name}: ${s.status}, interest ${s.interest_level}${s.next_follow_up_date ? ', next follow-up ' + s.next_follow_up_date : ''}`).join('\\n')\n  : 'No active pipeline data.';\n\nconst tasksSection = tasks.length\n  ? 'Pending tasks:\\n' + tasks.map(t => `- ${t.title} (${t.priority}${t.due_date ? ', due ' + t.due_date : ''})`).join('\\n')\n  : 'No pending tasks.';\n\nconst retrievedContext = [docSection, memorySection, pipelineSection, tasksSection].join('\\n\\n');\nconst documentIds = [...new Set(chunks.map(c => c.document_id).filter(Boolean))];\n\nreturn [{\n  json: {\n    question: $('Normalize & Check Auth').first().json.question,\n    user_id: $('Get Primary User').first().json[0].id,\n    retrieved_context: retrievedContext,\n    document_ids: documentIds,\n    chunk_count: chunks.length\n  }\n}];"
      },
      "id": "b2b2c2d2-0002-4002-8002-00000000000b",
      "name": "Build Retrieved Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-600, -150],
      "notes": "Blends document RAG results with live business data (memory, pipeline, tasks) into one context string, so a single reused prompt (knowledge_search) can answer both document questions and business-advisor questions - see documentation/knowledge-base-module.md."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/knowledge_documents",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "id", "value": "={{ $json.document_ids.length ? 'in.(' + $json.document_ids.join(',') + ')' : 'eq.00000000-0000-0000-0000-000000000000' }}" },
            { "name": "select", "value": "filename" }
          ]
        },
        "options": {}
      },
      "id": "b2b2c2d2-0002-4002-8002-00000000000c",
      "name": "Fetch Source Document Names",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-400, -150],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const context = $('Build Retrieved Context').first().json;\nreturn [{\n  json: {\n    prompt_key: 'knowledge_search',\n    user_id: context.user_id,\n    feature: 'kb_advisor',\n    variables: {\n      question: context.question,\n      retrieved_context: context.retrieved_context\n    }\n  }\n}];"
      },
      "id": "b2b2c2d2-0002-4002-8002-00000000000d",
      "name": "Build AI Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-200, -150]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "AI - Process Request"
        },
        "options": {}
      },
      "id": "b2b2c2d2-0002-4002-8002-00000000000e",
      "name": "Call AI - Process Request",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [0, -150]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/rpc/increment_document_access",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ doc_ids: $('Build Retrieved Context').first().json.document_ids }) }}",
        "options": {}
      },
      "id": "b2b2c2d2-0002-4002-8002-00000000000f",
      "name": "Increment Document Access",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, -150],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/search_history",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ user_id: $('Build Retrieved Context').first().json.user_id, query: $('Build Retrieved Context').first().json.question, result_count: $('Build Retrieved Context').first().json.chunk_count }) }}",
        "options": {}
      },
      "id": "b2b2c2d2-0002-4002-8002-000000000010",
      "name": "Log Search History",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, -150],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
