    {
      "parameters": {
        "jsCode": "const aiResult = $('Call AI - Process Request').first().json;\nconst sourceRows = $('Fetch Source Document Names').first().json || [];\nconst sources = [...new Set(sourceRows.map(d => d.filename))];\nreturn [{\n  json: {\n    success: true,\n    answer: aiResult.output,\n    sources\n  }\n}];"
      },
      "id": "b2b2c2d2-0002-4002-8002-000000000011",
