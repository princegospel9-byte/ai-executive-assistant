{
  "name": "KB - Answer Question",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kb-ask-advisor",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2b2c2d2-0002-4002-8002-000000000001",
      "name": "Called From Dashboard (Ask Advisor)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-2400, 0],
      "notes": "Requires header x-automation-secret. Body: { question }. Powers both the AI Advisor chat and the document-answer part of universal search - see documentation/knowledge-base-module.md."
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.body || {};\nconst providedSecret = item.headers?.['x-automation-secret'] || item.headers?.['X-Automation-Secret'];\nconst authOk = providedSecret === $vars.N8N_WEBHOOK_SECRET;\nreturn [{ json: { question: payload.question || '', auth_ok: authOk } }];"
      },
      "id": "b2b2c2d2-0002-4002-8002-000000000002",
      "name": "Normalize & Check Auth",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-2200, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.auth_ok }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2b2c2d2-0002-4002-8002-000000000003",
      "name": "Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-2000, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
