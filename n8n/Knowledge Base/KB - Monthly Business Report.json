    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/finance_entries",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "occurred_on", "value": "=gte.{{ new Date(new Date().getFullYear(), new Date().getMonth() - 1, 1).toISOString().split('T')[0] }}" },
            { "name": "occurred_on", "value": "=lte.{{ new Date(new Date().getFullYear(), new Date().getMonth(), 0).toISOString().split('T')[0] }}" },
            { "name": "select", "value": "entry_type,category,amount,currency" }
          ]
        },
        "options": {}
      },
      "id": "e4e4f4a4-0004-4004-8004-0000000000f1",
      "name": "Fetch Finance Entries This Month",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-900, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Phase 7 addition: finance_entries now exists (it didn't in Phase 6, when revenue_notes only had business_memory to draw on). Real income/expense totals take priority over the manual business_memory notes when entries exist."
    },
    {
      "parameters": {
        "jsCode": "const schools = $('Fetch All Schools').first().json || [];\nconst tasksCompleted = $('Fetch Tasks Completed').first().json || [];\nconst documents = $('Fetch Documents This Month').first().json || [];\nconst revenue = $('Fetch Revenue Notes').first().json || [];\nconst financeEntries = $input.first().json || [];\n\nconst now = new Date();\nconst periodStart = new Date(now.getFullYear(), now.getMonth() - 1, 1);\nconst periodEnd = new Date(now.getFullYear(), now.getMonth(), 0);\n\nconst newLeads = schools.filter(s => new Date(s.created_at) >= periodStart);\n// Best-effort proxy, not a real status-history log: a school counts as\n// converted/lost 'this month' if its status matches AND it was touched\n// (updated_at) within the period - see documentation/knowledge-base-module.md.\nconst converted = schools.filter(s => s.status === 'customer' && new Date(s.updated_at) >= periodStart);\nconst lost = schools.filter(s => s.status === 'lost_lead' && new Date(s.updated_at) >= periodStart);\n\nconst pipelineCounts = schools.reduce((acc, s) => { acc[s.status] = (acc[s.status] || 0) + 1; return acc; }, {});\nconst pipelineMovementText = Object.entries(pipelineCounts).map(([status, count]) => `- ${status}: ${count}`).join('\\n') || 'No pipeline data.';\n\nconst kbActivityText = `${documents.length} document(s) uploaded, ${documents.filter(d => d.status === 'ready').length} processed successfully.`;\n\nlet revenueText;\nif (financeEntries.length) {\n  const income = financeEntries.filter(e => e.entry_type === 'income').reduce((sum, e) => sum + Number(e.amount), 0);\n  const expenses = financeEntries.filter(e => e.entry_type === 'expense').reduce((sum, e) => sum + Number(e.amount), 0);\n  const currency = financeEntries[0].currency;\n  revenueText = `Income: ${currency} ${income.toFixed(2)}\\nExpenses: ${currency} ${expenses.toFixed(2)}\\nNet: ${currency} ${(income - expenses).toFixed(2)}`;\n} else {\n  revenueText = revenue.length\n    ? revenue.map(r => `- ${r.key}: ${r.value}`).join('\\n')\n    : 'Not tracked yet.';\n}\n\nreturn [{\n  json: {\n    period_start: periodStart.toISOString().split('T')[0],\n    period_end: periodEnd.toISOString().split('T')[0],\n    period_label: periodStart.toLocaleDateString(undefined, { month: 'long', year: 'numeric' }),\n    pipeline_movement: pipelineMovementText,\n    pipeline_counts: pipelineCounts,\n    new_leads_count: newLeads.length,\n    converted_count: converted.length,\n    lost_count: lost.length,\n    tasks_completed_count: tasksCompleted.length,\n    kb_activity_summary: kbActivityText,\n    revenue_notes: revenueText\n  }\n}];"
      },
      "id": "e4e4f4a4-0004-4004-8004-000000000007",
      "name": "Build Report Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-800, 0]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst userId = $('Get Primary User').first().json[0].id;\nreturn [{\n  json: {\n    prompt_key: 'monthly_business_report',\n    user_id: userId,\n    feature: 'monthly_business_report',\n    variables: {\n      period_label: input.period_label,\n      pipeline_movement: input.pipeline_movement,\n      new_leads_count: input.new_leads_count,\n      converted_count: input.converted_count,\n      lost_count: input.lost_count,\n      tasks_completed_count: input.tasks_completed_count,\n      kb_activity_summary: input.kb_activity_summary,\n      revenue_notes: input.revenue_notes\n    }\n  }\n}];"
      },
      "id": "e4e4f4a4-0004-4004-8004-000000000008",
      "name": "Build AI Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-600, 0]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "AI - Process Request"
        },
        "options": {}
      },
      "id": "e4e4f4a4-0004-4004-8004-000000000009",
      "name": "Call AI - Process Request",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [-400, 0]
    },
    {
      "parameters": {
        "jsCode": "const aiResult = $input.first().json;\nconst input = $('Build Report Input').first().json;\nconst userId = $('Get Primary User').first().json[0].id;\nconst output = aiResult.output;\n\nreturn [{\n  json: {\n    user_id: userId,\n    period_start: input.period_start,\n    period_end: input.period_end,\n    content_text: output.report_text,\n    content_json: { pipeline_counts: input.pipeline_counts, new_leads_count: input.new_leads_count, converted_count: input.converted_count, lost_count: input.lost_count, tasks_completed_count: input.tasks_completed_count },\n    insights: output.insights || []\n  }\n}];"
      },
      "id": "e4e4f4a4-0004-4004-8004-00000000000a",
      "name": "Prepare Report Insert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/monthly_reports?on_conflict=user_id,period_start",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "resolution=merge-duplicates,return=representation" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ user_id: $json.user_id, period_start: $json.period_start, period_end: $json.period_end, content_text: $json.content_text, content_json: $json.content_json }) }}",
        "options": {}
      },
      "id": "e4e4f4a4-0004-4004-8004-00000000000b",
      "name": "Upsert Monthly Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json;\nconst report = Array.isArray(rows) ? rows[0] : rows;\nreturn [{\n  json: {\n    user_id: report.user_id,\n    title: 'Your monthly business report is ready',\n    message: report.content_text.slice(0, 200),\n    severity: 'info',\n    channel: 'in_app',\n    related_record_type: 'monthly_report',\n    related_record_id: report.id\n  }\n}];"
      },
      "id": "e4e4f4a4-0004-4004-8004-00000000000c",
      "name": "Build Notification Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, -150]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "",
