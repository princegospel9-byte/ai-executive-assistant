              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "=eq.{{ $json.ticket_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ draft_response: $json.draft_reply, status: 'awaiting_approval' }) }}",
        "options": {}
      },
      "id": "h7h7c7d7-0007-4007-8007-00000000000c",
      "name": "Update Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -200,
        -150
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const prep = $('Prepare Ticket Update').first().json;\nreturn [{\n  json: {\n    user_id: prep.user_id,\n    action_type: 'send_support_reply',\n    payload: { ticket_id: prep.ticket_id, contact_email: prep.contact_email, subject: prep.subject, draft_reply: prep.draft_reply },\n    related_record_type: 'support_ticket',\n    related_record_id: prep.ticket_id,\n    ticket_id: prep.ticket_id\n  }\n}];"
      },
