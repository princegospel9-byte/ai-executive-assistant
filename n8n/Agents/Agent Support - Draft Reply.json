{
  "name": "Agent Support - Draft Reply",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agent-support-draft",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "h7h7c7d7-0007-4007-8007-000000000001",
      "name": "Called From Dashboard (Draft Reply)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -2200,
        0
      ],
      "notes": "Requires header x-automation-secret. Body: { ticket_id }. Reuses the Phase 6 document-RAG pattern (match_document_chunks) for product-doc grounding, and the Phase 5 approval-linking pattern for the send gate.",
      "webhookId": "d044a94e-47fc-4c3d-8685-3a602052b7c3"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.body || {};\nconst providedSecret = item.headers?.['x-automation-secret'] || item.headers?.['X-Automation-Secret'];\nconst authOk = providedSecret === $env.N8N_WEBHOOK_SECRET;\nreturn [{ json: { ticket_id: payload.ticket_id, auth_ok: authOk } }];"
      },
      "id": "h7h7c7d7-0007-4007-8007-000000000002",
      "name": "Normalize & Check Auth",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2000,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.auth_ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "h7h7c7d7-0007-4007-8007-000000000003",
      "name": "Authorized?",
