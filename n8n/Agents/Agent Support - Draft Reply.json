      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -1600,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/support_tickets",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "=eq.{{ $('Normalize & Check Auth').first().json.ticket_id }}"
            },
            {
              "name": "select",
              "value": "*"
            }
          ]
        },
        "options": {}
      },
      "id": "h7h7c7d7-0007-4007-8007-000000000005",
      "name": "Fetch Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1600,
        -150
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json;\nconst ticket = Array.isArray(rows) ? rows[0] : rows;\nif (!ticket) {\n  throw new Error('Ticket not found: ' + $('Normalize & Check Auth').first().json.ticket_id);\n}\nreturn [{ json: ticket }];"
      },
      "id": "h7h7c7d7-0007-4007-8007-000000000006",
      "name": "Require Ticket Found",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1400,
        -150
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.voyageai.com/v1/embeddings",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.VOYAGE_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ input: [$json.subject + ': ' + $json.description], model: 'voyage-3.5', input_type: 'query' }) }}",
        "options": {}
      },
      "id": "h7h7c7d7-0007-4007-8007-000000000007",
      "name": "Embed Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1200,
        -150
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/match_document_chunks",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query_embedding: $json.data[0].embedding, match_user_id: $('Require Ticket Found').first().json.user_id, match_count: 5 }) }}",
        "options": {}
      },
      "id": "h7h7c7d7-0007-4007-8007-000000000008",
      "name": "Vector Search Docs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1000,
        -150
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const ticket = $('Require Ticket Found').first().json;\nconst chunks = $input.all().map(item => item.json).filter(item => item && Object.keys(item).length > 0) || [];\n\nconst docText = chunks.length\n  ? 'Relevant product documentation:\\n' + chunks.map(c => `- ${c.content}`).join('\\n\\n')\n  : 'No relevant documentation found.';\n\nconst context = `Ticket subject: ${ticket.subject}\\nTicket description: ${ticket.description}\\nPriority: ${ticket.priority}\\n\\n${docText}`;\n\nreturn [{\n  json: {\n    prompt_key: 'agent_support',\n    user_id: ticket.user_id,\n    feature: 'agent_support',\n    related_record_type: 'support_ticket',\n    related_record_id: ticket.id,\n    ticket_id: ticket.id,\n    contact_email: ticket.contact_email,\n    subject: ticket.subject,\n    variables: {\n      subtask: 'Draft a reply to this support ticket.',\n      context\n    }\n  }\n}];"
      },
      "id": "h7h7c7d7-0007-4007-8007-000000000009",
      "name": "Build AI Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -800,
        -150
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "NScqkbAehRkYoqbX",
          "mode": "list",
          "cachedResultName": "AI - Process Request"
        },
        "options": {}
      },
      "id": "h7h7c7d7-0007-4007-8007-00000000000a",
      "name": "Call AI - Process Request",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        -600,
        -150
      ]
    },
    {
      "parameters": {
        "jsCode": "const aiResult = $input.first().json;\nconst built = $('Build AI Request').first().json;\nconst draftReply = aiResult.output?.draft_reply || aiResult.raw_text;\n\nreturn [{\n  json: {\n    ticket_id: built.ticket_id,\n    user_id: built.user_id,\n    contact_email: built.contact_email,\n    subject: built.subject,\n    draft_reply: draftReply\n  }\n}];"
      },
      "id": "h7h7c7d7-0007-4007-8007-00000000000b",
      "name": "Prepare Ticket Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        -150
      ]
    },
