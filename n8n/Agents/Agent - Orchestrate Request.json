    {
      "parameters": {
        "jsCode": "const agents = $('Fetch Active Agents').all().map(item => item.json).filter(item => item && Object.keys(item).length > 0) || [];\nconst pipeline = $('Fetch Active Pipeline').all().map(item => item.json).filter(item => item && Object.keys(item).length > 0) || [];\nconst memory = $('Fetch Business Memory').all().map(item => item.json).filter(item => item && Object.keys(item).length > 0) || [];\nconst finance = $('Fetch Recent Finance Entries').all().map(item => item.json).filter(item => item && Object.keys(item).length > 0) || [];\nconst tasks = $('Fetch Pending Tasks').all().map(item => item.json).filter(item => item && Object.keys(item).length > 0) || [];\nconst runs = $('Fetch Recent Automation Runs').all().map(item => item.json).filter(item => item && Object.keys(item).length > 0) || [];\nconst tickets = $('Fetch Open Support Tickets').all().map(item => item.json).filter(item => item && Object.keys(item).length > 0) || [];\n\nconst mmFindings = $('Fetch Recent MM Findings').all().map(item => item.json).filter(item => item && Object.keys(item).length > 0) || [];\n\nconst availableAgentsText = agents.map(a => `- ${a.agent_key}: ${a.description}`).join('\\n');\n\nconst pipelineText = pipeline.length\n  ? pipeline.map(s => `- ${s.school_name}: ${s.status}, interest ${s.interest_level}${s.next_follow_up_date ? ', next follow-up ' + s.next_follow_up_date : ''}`).join('\\n')\n  : 'No active pipeline.';\n\nconst memoryText = memory.length\n  ? memory.map(m => `- [${m.category}] ${m.key}: ${m.value}`).join('\\n')\n  : 'No business memory saved yet.';\n\nconst financeText = finance.length\n  ? finance.map(f => `- ${f.occurred_on} ${f.entry_type} (${f.category}): ${f.currency} ${f.amount}${f.description ? ' - ' + f.description : ''}`).join('\\n')\n  : 'No finance entries logged in the last 60 days.';\n\nconst tasksText = tasks.length\n  ? tasks.map(t => `- ${t.title} (${t.priority}${t.category ? ', ' + t.category : ''}${t.due_date ? ', due ' + t.due_date : ''})`).join('\\n')\n  : 'No pending tasks.';\n\nconst runsText = runs.length\n  ? runs.map(r => `- ${r.workflow_name}: ${r.status}${r.duration_ms ? ', ' + r.duration_ms + 'ms' : ''}${r.error_message ? ', error: ' + r.error_message : ''}`).join('\\n')\n  : 'No recent automation runs logged.';\n\nconst ticketsText = tickets.length\n  ? tickets.map(t => `- ${t.subject} (${t.priority}, ${t.status})`).join('\\n')\n  : 'No open support tickets.';\n\nconst mmFindingsText = mmFindings.length\n  ? mmFindings.map(f => `- [${f.severity}] ${f.classification ?? 'UNCLASSIFIED'} ${f.rule_id} ${f.finding_type} on ${f.entity_type} ${f.entity_id} (business_date ${f.business_date}): expected ${f.expected_value}, actual ${f.actual_value}, variance ${f.variance}. Evidence: ${JSON.stringify(f.evidence)}`).join('\\n')\n  : 'No open MoneyManager monitoring findings.';\n\nreturn [{\n  json: {\n    agents,\n    available_agents_text: availableAgentsText,\n    context_by_key: {\n      sales: `Sales pipeline:\\n${pipelineText}`,\n      marketing: `Business context:\\n${memoryText}`,\n      finance: `Finance entries (last 60 days):\\n${financeText}`,\n      support: `Open support tickets:\\n${ticketsText}`,\n      research: `Business context:\\n${memoryText}`,\n      operations: `Pending tasks:\\n${tasksText}\\n\\nRecent automation runs:\\n${runsText}`,\n      transaction_integrity: `MoneyManager monitoring findings:\\n${mmFindingsText}`,\n      reconciliation: `MoneyManager monitoring findings:\\n${mmFindingsText}`,\n      business_performance: `MoneyManager monitoring findings:\\n${mmFindingsText}`\n    }\n  }\n}];"
      },
      "id": "f5f5a5b5-0005-4005-8005-00000000000d",
      "name": "Build Context Bundle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1200,
        -150
      ],
      "notes": "One prefetch of everything up front rather than a per-agent branch that fetches only what's needed - simpler workflow structure, acceptable trade-off for a low-frequency, user-initiated request."
    },
    {
      "parameters": {
        "jsCode": "const bundle = $input.first().json;\nconst request = $('Normalize & Check Auth').first().json.request;\nconst userId = $('Get Primary User').first().json.id;\nreturn [{\n  json: {\n    prompt_key: 'agent_router',\n    user_id: userId,\n    feature: 'agent_router',\n    variables: {\n      available_agents: bundle.available_agents_text,\n      request\n    }\n  }\n}];"
      },
      "id": "f5f5a5b5-0005-4005-8005-00000000000e",
