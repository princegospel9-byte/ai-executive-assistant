      "id": "f5f5a5b5-0005-4005-8005-00000000000f",
      "name": "Call AI - Process Request (Router)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        -800,
        -150
      ]
    },
    {
      "parameters": {
        "jsCode": "const routerResult = $input.first().json;\nconst bundle = $('Build Context Bundle').first().json;\nconst request = $('Normalize & Check Auth').first().json.request;\nconst userId = $('Get Primary User').first().json.id;\n\nconst selected = (routerResult.output?.agents || []).filter(a => bundle.agents.some(x => x.agent_key === a.agent_key));\nconst taskRows = selected.map(s => {\n  const agent = bundle.agents.find(x => x.agent_key === s.agent_key);\n  return { user_id: userId, agent_id: agent.id, parent_request: request, subtask: s.subtask, priority: 'medium', status: 'pending' };\n});\n\nreturn [{ json: { task_rows: taskRows, request, user_id: userId } }];"
      },
      "id": "f5f5a5b5-0005-4005-8005-000000000010",
      "name": "Parse Router Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -600,
        -150
      ],
      "notes": "Filters out any agent_key the router might return that isn't a real active agent, rather than trusting the model's output blindly - a null agent_id would violate the agent_tasks FK."
    },
