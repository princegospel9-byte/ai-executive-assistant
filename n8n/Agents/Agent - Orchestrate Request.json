      "parameters": {
        "jsCode": "const rows = $input.first().json;\nconst output = Array.isArray(rows) ? rows[0] : rows;\nconst prep = $('Prepare Output Insert').item.json;\nreturn [{\n  json: {\n    user_id: prep.user_id,\n    action_type: prep.agent_key === 'marketing' ? 'publish_content' : 'agent_recommendation',\n    payload: { agent_output_id: output.id, agent_key: prep.agent_key, output_text: prep.output_text, output_json: prep.output_json },\n    related_record_type: 'agent_output',\n    related_record_id: output.id,\n    agent_output_id: output.id\n  }\n}];"
      },
