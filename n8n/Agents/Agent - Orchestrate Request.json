      "parameters": {
        "jsCode": "const aiResult = $input.first().json;\nconst built = $('Build Per-Agent AI Request').item.json;\nconst output = aiResult.output || {};\n\nreturn [{\n  json: {\n    user_id: built.user_id,\n    agent_task_id: built.agent_task_id,\n    agent_key: built.agent_key,\n    agent_name: built.agent_name,\n    output_text: output.summary || aiResult.raw_text || JSON.stringify(output),\n    output_json: output,\n    requires_approval: !!output.requires_approval,\n    status: output.requires_approval ? 'pending_approval' : 'info'\n  }\n}];"
      },
