        "jsCode": "const prep = $('Prepare Output Insert').item.json;\nlet approvalId = null;\ntry {\n  approvalId = $('Call Request Approval').item.json.approval_id ?? null;\n} catch (e) {\n  // Not reached on the no-approval branch - approvalId stays null, which is correct.\n}\nreturn [{ json: { agent_key: prep.agent_key, agent_name: prep.agent_name, output_text: prep.output_text, requires_approval: prep.requires_approval, approval_id: approvalId } }];"
      },
