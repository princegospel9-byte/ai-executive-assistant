    {
      "parameters": {
        "jsCode": "const task = $json;\nconst bundle = $('Build Context Bundle').first().json;\nconst agent = bundle.agents.find(a => a.id === task.agent_id);\nconst context = bundle.context_by_key[agent.agent_key] || 'No additional context available.';\n\nreturn [{\n  json: {\n    prompt_key: 'agent_' + agent.agent_key,\n    user_id: task.user_id,\n    feature: 'agent_' + agent.agent_key,\n    related_record_type: 'agent_task',\n    related_record_id: task.id,\n    enable_web_search: agent.agent_key === 'research',\n    agent_task_id: task.id,\n    agent_id: agent.id,\n    agent_key: agent.agent_key,\n    agent_name: agent.name,\n    variables: {\n      subtask: task.subtask,\n      context\n    }\n  }\n}];"
