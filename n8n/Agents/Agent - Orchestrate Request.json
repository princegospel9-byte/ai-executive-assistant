      "parameters": {
        "jsCode": "const items = $input.first().json.data || [];\nconst request = $('Normalize & Check Auth').first().json.request;\nconst userId = $('Get Primary User').first().json.id;\n\nconst outputsText = items.map(i => `${i.agent_name}:\\n${i.output_text}`).join('\\n\\n');\n\nreturn [{\n  json: {\n    prompt_key: 'agent_combine_results',\n    user_id: userId,\n    feature: 'agent_combine_results',\n    variables: { request, agent_outputs: outputsText },\n    agent_runs: items.map(i => ({ agent_key: i.agent_key, agent_name: i.agent_name, output_text: i.output_text, requires_approval: i.requires_approval, approval_id: i.approval_id }))\n  }\n}];"
