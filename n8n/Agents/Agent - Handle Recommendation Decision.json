{
  "name": "Agent - Handle Recommendation Decision",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agent-decision",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "g6g6b6c6-0006-4006-8006-000000000001",
      "name": "Called From Dashboard (Agent Decision)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1600, 0],
      "notes": "Requires header x-automation-secret. Body: { approval_id, decision: 'approved' | 'rejected' }. Generic approve/reject for agent_outputs that have no dedicated send action of their own (Marketing content, and Sales/Finance/Research/Operations recommendations) - approving just means Prince has reviewed and accepted it, nothing external happens. Support ticket replies use their own Agent - Handle Support Reply Decision instead, since those actually send an email."
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.body || {};\nconst providedSecret = item.headers?.['x-automation-secret'] || item.headers?.['X-Automation-Secret'];\nconst authOk = providedSecret === $vars.N8N_WEBHOOK_SECRET;\nreturn [{ json: { approval_id: payload.approval_id, decision: payload.decision, auth_ok: authOk } }];"
      },
      "id": "g6g6b6c6-0006-4006-8006-000000000002",
      "name": "Normalize & Check Auth",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1400, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.auth_ok }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "g6g6b6c6-0006-4006-8006-000000000003",
      "name": "Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-1200, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, error: 'Unauthorized' } }}",
        "options": { "responseCode": 401 }
      },
      "id": "g6g6b6c6-0006-4006-8006-000000000004",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-1000, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/agent_outputs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "approval_id", "value": "=eq.{{ $('Normalize & Check Auth').first().json.approval_id }}" },
            { "name": "select", "value": "*" }
          ]
        },
        "options": {}
      },
      "id": "g6g6b6c6-0006-4006-8006-000000000005",
      "name": "Fetch Output By Approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1000, -150],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $('Normalize & Check Auth').first().json.decision }}",
              "rightValue": "approved",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "g6g6b6c6-0006-4006-8006-000000000006",
      "name": "Is Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-800, -150]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/agent_outputs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{ "name": "approval_id", "value": "=eq.{{ $('Normalize & Check Auth').first().json.approval_id }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'approved' }) }}",
        "options": {}
      },
      "id": "g6g6b6c6-0006-4006-8006-000000000007",
      "name": "Mark Output Approved",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-600, -300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/agent_outputs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{ "name": "approval_id", "value": "=eq.{{ $('Normalize & Check Auth').first().json.approval_id }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'rejected' }) }}",
        "options": {}
      },
      "id": "g6g6b6c6-0006-4006-8006-000000000008",
      "name": "Mark Output Rejected",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-600, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/approvals",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{ "name": "id", "value": "=eq.{{ $('Normalize & Check Auth').first().json.approval_id }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: $('Normalize & Check Auth').first().json.decision, decided_at: new Date().toISOString() }) }}",
        "options": {}
      },
      "id": "g6g6b6c6-0006-4006-8006-000000000009",
      "name": "Update Approval Record",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-400, -150],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Both branches (approved/rejected) converge here - approvals.status accepts the same 'approved'/'rejected' values as the decision itself."
    },
    {
      "parameters": {
        "jsCode": "const output = $('Fetch Output By Approval').first().json;\nconst row = Array.isArray(output) ? output[0] : output;\nconst decision = $('Normalize & Check Auth').first().json.decision;\nreturn [{\n  json: {\n    user_id: row.user_id,\n    context_type: 'approval_decision',\n    context_summary: (row.output_text || '').slice(0, 500),\n    outcome: decision,\n    related_record_type: 'agent_output',\n    related_record_id: row.id\n  }\n}];"
      },
      "id": "g6g6b6c6-0006-4006-8006-00000000000f",
      "name": "Prepare Learning Entry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-400, 50],
      "notes": "Phase 9 addition (Module 13, Learning System): every approve/reject decision on an agent recommendation becomes a system_learning row - one concrete integration point, not wired into every decision workflow across the system yet (Email/CRM/Support sends have their own separate Handle Decision workflows, not touched here)."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/system_learning",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "g6g6b6c6-0006-4006-8006-000000000010",
      "name": "Insert Learning Entry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-200, 50],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const decision = $('Normalize & Check Auth').first().json.decision;\nreturn [{ json: { success: true, status: decision } }];"
      },
      "id": "g6g6b6c6-0006-4006-8006-00000000000a",
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-200, -150]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": { "responseCode": 200 }
      },
      "id": "g6g6b6c6-0006-4006-8006-00000000000b",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [0, -150]
    }
  ],
  "connections": {
    "Called From Dashboard (Agent Decision)": {
      "main": [[{ "node": "Normalize & Check Auth", "type": "main", "index": 0 }]]
    },
    "Normalize & Check Auth": {
      "main": [[{ "node": "Authorized?", "type": "main", "index": 0 }]]
    },
    "Authorized?": {
      "main": [
        [{ "node": "Fetch Output By Approval", "type": "main", "index": 0 }],
        [{ "node": "Respond 401", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Output By Approval": {
      "main": [[{ "node": "Is Approved?", "type": "main", "index": 0 }]]
    },
    "Is Approved?": {
      "main": [
        [{ "node": "Mark Output Approved", "type": "main", "index": 0 }],
        [{ "node": "Mark Output Rejected", "type": "main", "index": 0 }]
      ]
    },
    "Mark Output Approved": {
      "main": [[{ "node": "Update Approval Record", "type": "main", "index": 0 }]]
    },
    "Mark Output Rejected": {
      "main": [[{ "node": "Update Approval Record", "type": "main", "index": 0 }]]
    },
    "Update Approval Record": {
      "main": [
        [
          { "node": "Build Response", "type": "main", "index": 0 },
          { "node": "Prepare Learning Entry", "type": "main", "index": 0 }
        ]
      ]
    },
    "Prepare Learning Entry": {
      "main": [[{ "node": "Insert Learning Entry", "type": "main", "index": 0 }]]
    },
    "Build Response": {
      "main": [[{ "node": "Respond 200", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": ""
  },
  "pinData": {}
}