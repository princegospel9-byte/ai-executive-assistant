{
  "name": "Agent Support - Handle Send Decision",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agent-support-decision",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "i8i8d8e8-0008-4008-8008-000000000001",
      "name": "Called From Dashboard (Approve/Reject)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-2000, 0],
      "notes": "Requires header x-automation-secret. Body: { approval_id, decision: 'approved' | 'rejected' }. Mirrors School CRM - Handle Send Decision - fresh outbound email, not a reply."
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.body || {};\nconst providedSecret = item.headers?.['x-automation-secret'] || item.headers?.['X-Automation-Secret'];\nconst authOk = providedSecret === $vars.N8N_WEBHOOK_SECRET;\nreturn [{ json: { approval_id: payload.approval_id, decision: payload.decision, auth_ok: authOk } }];"
      },
      "id": "i8i8d8e8-0008-4008-8008-000000000002",
      "name": "Normalize & Check Auth",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1800, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.auth_ok }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "i8i8d8e8-0008-4008-8008-000000000003",
      "name": "Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-1600, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, error: 'Unauthorized' } }}",
        "options": { "responseCode": 401 }
      },
      "id": "i8i8d8e8-0008-4008-8008-000000000004",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-1400, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/support_tickets",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "approval_id", "value": "=eq.{{ $('Normalize & Check Auth').first().json.approval_id }}" },
            { "name": "select", "value": "*" }
          ]
        },
        "options": {}
      },
      "id": "i8i8d8e8-0008-4008-8008-000000000005",
      "name": "Fetch Ticket By Approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1400, -150],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $('Normalize & Check Auth').first().json.decision }}",
              "rightValue": "approved",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "i8i8d8e8-0008-4008-8008-000000000006",
      "name": "Is Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-1200, -150]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json;\nconst ticket = Array.isArray(rows) ? rows[0] : rows;\nif (!ticket.contact_email) {\n  throw new Error('Ticket has no contact_email - cannot send a reply for ticket ' + ticket.id);\n}\n\nconst subject = `Re: ${ticket.subject}`;\nconst rawMessage = [\n  `To: ${ticket.contact_email}`,\n  `Subject: ${subject}`,\n  'Content-Type: text/plain; charset=utf-8',\n  '',\n  ticket.draft_response\n].join('\\r\\n');\n\nconst base64url = Buffer.from(rawMessage).toString('base64')\n  .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\n\nreturn [{ json: { raw: base64url, ticket_id: ticket.id, user_id: ticket.user_id, contact_email: ticket.contact_email } }];"
      },
      "id": "i8i8d8e8-0008-4008-8008-000000000007",
      "name": "Build Raw Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1000, -300],
      "notes": "Fresh outbound email, not a reply - same as School CRM - Handle Send Decision, no threading headers even though the subject reads 'Re:'."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages/send",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ raw: $json.raw }) }}",
        "options": {}
      },
      "id": "i8i8d8e8-0008-4008-8008-000000000008",
      "name": "Send Gmail Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-800, -300],
      "credentials": { "gmailOAuth2": { "id": "", "name": "Gmail account" } },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "notes": "2 retries, not 3 - avoid risking a duplicate send to a real customer."
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/support_tickets",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{ "name": "id", "value": "=eq.{{ $('Build Raw Email').first().json.ticket_id }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'resolved', resolved_at: new Date().toISOString() }) }}",
        "options": {}
      },
      "id": "i8i8d8e8-0008-4008-8008-000000000009",
      "name": "Mark Ticket Resolved",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-600, -300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/approvals",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{ "name": "id", "value": "=eq.{{ $('Normalize & Check Auth').first().json.approval_id }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'approved', decided_at: new Date().toISOString() }) }}",
        "options": {}
      },
      "id": "i8i8d8e8-0008-4008-8008-00000000000a",
      "name": "Mark Approval Approved",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-400, -300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const built = $('Build Raw Email').first().json;\nreturn [{\n  json: {\n    user_id: built.user_id,\n    title: 'Support reply sent',\n    message: `Your reply to ${built.contact_email} was sent.`,\n    severity: 'info',\n    channel: 'in_app',\n    related_record_type: 'support_ticket',\n    related_record_id: built.ticket_id\n  }\n}];"
      },
      "id": "i8i8d8e8-0008-4008-8008-00000000000b",
      "name": "Build Notification Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-200, -300]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "Notifications - Send Notification"
        },
        "options": {}
      },
      "id": "i8i8d8e8-0008-4008-8008-00000000000c",
      "name": "Notify",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [0, -300]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { success: true, status: 'sent' } }];"
      },
      "id": "i8i8d8e8-0008-4008-8008-00000000000d",
      "name": "Build Success Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, -300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/support_tickets",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "approval_id", "value": "=eq.{{ $('Normalize & Check Auth').first().json.approval_id }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'open', draft_response: null }) }}",
        "options": {}
      },
      "id": "i8i8d8e8-0008-4008-8008-00000000000e",
      "name": "Reopen Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1000, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $vars.SUPABASE_URL }}/rest/v1/approvals",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $vars.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "id", "value": "=eq.{{ $('Normalize & Check Auth').first().json.approval_id }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'rejected', decided_at: new Date().toISOString() }) }}",
        "options": {}
      },
      "id": "i8i8d8e8-0008-4008-8008-00000000000f",
      "name": "Mark Approval Rejected",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-800, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { success: true, status: 'rejected' } }];"
      },
      "id": "i8i8d8e8-0008-4008-8008-000000000010",
      "name": "Build Rejected Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-600, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": { "responseCode": 200 }
      },
      "id": "i8i8d8e8-0008-4008-8008-000000000011",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [600, -150]
    }
  ],
