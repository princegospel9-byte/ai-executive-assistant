# Copy this file to /etc/kbrisks/agent.env on the VPS, fill in real values,
# then: chmod 640 /etc/kbrisks/agent.env && chown root:kbrisks /etc/kbrisks/agent.env
# Never commit the real file - this .example stays empty on purpose.
# See documentation/vps-deployment-guide.md for the full deployment procedure.

# Supabase project settings - same values as this repo's own .env.local
# (Project Settings > API in your Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# n8n webhook - required ONLY for the notification DELIVERY step, not for
# report generation/persistence. A real run with these left blank still
# completes and persists to Supabase (mm_monitoring_runs/mm_findings/
# mm_alerts) - it only fails at the final send step (exit code 3). Leave
# blank until n8n is actually installed on this VPS.
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=

# Overrides the default <repo>/.mm-daily-report-state/ location. Strongly
# recommended on a VPS: keeps the duplicate-run lock/"already sent" marker
# files outside the git-managed application directory, so a redeploy
# (git clean / fresh clone) can never silently wipe them.
MM_DAILY_REPORT_STATE_DIR=/var/lib/kbrisks/mm-daily-report-state
