# Copy to .env in this same folder before running docker compose up.

# Basic auth for the n8n web UI itself - separate from N8N_WEBHOOK_SECRET
# (which protects the webhook endpoints your Next.js app calls).
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# Only needed once you have a real domain/reverse proxy in front of this.
# Leave unset for local/LAN use - the defaults (localhost, http) are fine.
N8N_HOST=
N8N_PROTOCOL=
WEBHOOK_URL=