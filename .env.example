# Supabase project settings — Project Settings > API in your Supabase dashboard.
# Safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER-SIDE ONLY. Bypasses Row Level Security entirely.
# Never prefix with NEXT_PUBLIC_, never commit it, never reference it from
# client components. Only used in server-only code (API routes, later n8n/agent
# workflows that intentionally need cross-user access).
SUPABASE_SERVICE_ROLE_KEY=

# n8n webhook base URL — e.g. https://your-n8n-host/webhook (no trailing slash).
# Used by Server Actions to trigger draft regeneration and approval decisions.
N8N_WEBHOOK_BASE_URL=

# Shared secret sent as the x-automation-secret header on every n8n webhook
# call. Must match the N8N_WEBHOOK_SECRET Variable set inside n8n itself -
# without this, anyone who found a webhook URL could trigger an email send.
N8N_WEBHOOK_SECRET=